# Legacy template kept for reference.
# Prefer ops/david/david-backup.service for the active Lightsail deployment path.
[Unit]
Description=David off-site backup job
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/opt/david
EnvironmentFile=/opt/david/.env
ExecStart=/opt/david/scripts/backup.sh
