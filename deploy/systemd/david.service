# Legacy template kept for reference.
# Prefer ops/david/david.service for the active Lightsail deployment path.
[Unit]
Description=David Telegram assistant
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/david
EnvironmentFile=/opt/david/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/env uv run python main.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
