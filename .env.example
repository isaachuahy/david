# Runtime Configuration
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
ALLOWED_USER_ID="your_telegram_user_id_here"

# Gemini AI
GEMINI_API_KEY="your_gemini_api_key_here"

# Routing uses native Gemini by default; both candidates use low reasoning.
# DAVID_ROUTING_MODEL="gemini-3.5-flash-lite"
# Optional Luna alternative requires OpenRouter:
# DAVID_ROUTING_MODEL="openai/gpt-5.6-luna"
# OPENROUTER_API_KEY="your_openrouter_api_key_here"

# Optional model overrides, resolved centrally in config.py.
# GEMINI_CHAT_MODEL="gemini-3-flash-preview"
# GEMINI_REVIEW_MODEL="gemini-3-flash-preview"
# GEMINI_REVIEW_FALLBACK_MODEL="gemini-3.1-pro-preview"
# GEMINI_SYNTHESIS_MODEL="gemini-3-flash-preview"

# Google Calendar Integration
# Note: OAuth setup should create token.json before VPS deployment if you want
# headless Google Calendar access on first boot.
GOOGLE_CREDENTIALS_PATH="credentials.json"
GOOGLE_TOKEN_PATH="token.json"

# Optional path override for SQLite
# DAVID_DB_PATH="data/assistant.db"
# DAVID_TELEGRAM_PERSISTENCE_PATH="data/telegram_state.pkl"
# DAVID_CONTEXT_DIR="context"

# Backup Configuration
# Used by scripts/backup.sh and the david-backup systemd unit.
DAVID_BACKUP_REMOTE="b2:your-bucket-name/david"
DAVID_BACKUP_HOST="lightsail-prod"
DAVID_BACKUP_TMPDIR="/tmp/david-backups"
DAVID_PROJECT_DIR="/opt/david"
DAVID_CONTEXT_DIR="/opt/david/context"

# Langfuse Observability
LANGFUSE_PUBLIC_KEY="pk-lf-..."
LANGFUSE_SECRET_KEY="sk-lf-..."
LANGFUSE_HOST="https://cloud.langfuse.com"

# Sentry Alerting
SENTRY_DSN="your_sentry_dsn_here"
