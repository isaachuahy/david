GOOGLE_TOKEN_PATH="token.json"

# Langfuse Observability
LANGFUSE_PUBLIC_KEY="pk-lf-..."
LANGFUSE_SECRET_KEY="sk-lf-..."
LANGFUSE_HOST="https://cloud.langfuse.com"

# Sentry Alerting
SENTRY_DSN="your_sentry_dsn_here"