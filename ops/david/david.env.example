# Copy to /etc/david/david.env and set real values.
# This file is the runtime config for the production systemd units.

# Required app secrets
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
ALLOWED_USER_ID="your_telegram_user_id_here"
GEMINI_API_KEY="your_gemini_api_key_here"

# Google Calendar credentials
# Keep the OAuth client JSON in /etc/david and the refreshable token in /var/lib/david.
GOOGLE_CREDENTIALS_PATH="/etc/david/credentials.json"
GOOGLE_TOKEN_PATH="/var/lib/david/token.json"

# Runtime state
DAVID_DB_PATH="/var/lib/david/assistant.db"
DAVID_TELEGRAM_PERSISTENCE_PATH="/var/lib/david/telegram_state.pkl"

# Context files
# Keep production context in /var/lib so it stays separate from the code checkout.
DAVID_CONTEXT_DIR="/var/lib/david/context"
DAVID_PROJECT_DIR="/opt/david"

# Backup configuration
DAVID_BACKUP_REMOTE="b2:your-bucket-name/david"
DAVID_BACKUP_HOST="lightsail-prod"
DAVID_BACKUP_TMPDIR="/tmp/david-backups"

# Optional observability
LANGFUSE_PUBLIC_KEY="pk-lf-..."
LANGFUSE_SECRET_KEY="sk-lf-..."
LANGFUSE_HOST="https://cloud.langfuse.com"
SENTRY_DSN="your_sentry_dsn_here"
